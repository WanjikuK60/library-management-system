generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(PATRON)
  reviews      Review[]
  spaceBookings SpaceBooking[]
  readingListEntries ReadingListEntry[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Genre {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  isbn        String   @unique
  description String?
  publishedAt DateTime?
  totalCopies Int      @default(1)
  genreId     String
  genre       Genre    @relation(fields: [genreId], references: [id], onDelete: Restrict)
  reviews     Review[]
  readingListEntries ReadingListEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([genreId])
  @@index([title])
}

model ReadingListEntry {
  userId    String
  bookId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
  @@index([bookId])
}

model Review {
  id        String   @id @default(cuid())
  bookId    String
  userId    String
  rating    Int
  comment   String?
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, userId])
  @@index([userId])
}

model SpaceBooking {
  id        String   @id @default(cuid())
  userId    String
  space     String
  date      DateTime @db.Date
  startTime String
  endTime   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([space, date])
  @@index([userId])
}
