{
  "info": {
    "name": "Library Management API",
    "description": "Authentication, genre CRUD, and book catalog endpoints. Set the bearer token after registering or logging in to use librarian-only book mutations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "genreId", "value": "replace-with-genre-id" },
    { "key": "bookId", "value": "replace-with-book-id" },
    { "key": "token", "value": "replace-with-access-token" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"reader@example.com\",\n  \"name\": \"Reader\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"reader@example.com\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create genre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Science Fiction\",\n  \"description\": \"Speculative fiction\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/genres"
          }
        },
        { "name": "List genres", "request": { "method": "GET", "url": "{{baseUrl}}/genres" } },
        { "name": "Get genre", "request": { "method": "GET", "url": "{{baseUrl}}/genres/{{genreId}}" } },
        {
          "name": "Update genre",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated description\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        },
        { "name": "Delete genre", "request": { "method": "DELETE", "url": "{{baseUrl}}/genres/{{genreId}}" } }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create book (librarian token required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"9780441172719\",\n  \"totalCopies\": 5,\n  \"genreId\": \"{{genreId}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/books"
          }
        },
        { "name": "List books (filter and paginate)", "request": { "method": "GET", "url": "{{baseUrl}}/books?genreId={{genreId}}&search=dune&page=1&limit=10" } },
        { "name": "Get book", "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}" } },
        {
          "name": "Update book (librarian token required)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"totalCopies\": 6\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Delete book (librarian token required)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        }
      ]
    }
  ]
}
